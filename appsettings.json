{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=matchapp.db"
  },
  "Jwt": {
    "Key": "CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_KEY_AT_LEAST_32_CHARS",
    "Issuer": "MatchApp",
    "Audience": "MatchApp.Client",
    "ExpiresMinutes": 10080
  },
  "FileStorage": {
    "Root": "wwwroot/uploads",
    "MaxImageBytes": 10485760,
    "MaxVideoBytes": 52428800
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
